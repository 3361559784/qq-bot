# 屏蔽依赖包 (重中之重！)
node_modules/

# 屏蔽 JetBrains 配置 (WebStorm/PyCharm)
.idea/
*.iws
*.iml
*.ipr

# 屏蔽 Mac 系统垃圾文件
.DS_Store

# 屏蔽环境变量 (保护隐私，防止 Token 泄露！)
.env
local.settings.json
# Local env files (should not be committed)
.env.local

# ignore build outputs and cache for campus-ai-web
/campus-ai-web/.next/
/campus-ai-web/node_modules/

# campus-ai-web standalone deploy artifacts (should never be committed)
/campus-ai-web/deploy.zip
/campus-ai-web/deploy-package/
/campus-ai-web/.deploy/

# 屏蔽日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 屏蔽本地 Functions 调试产物
.func-local.log
.func-local.pid

# 屏蔽构建输出
dist/
out/

# 屏蔽部署/产物
.deployment
.deployment_temp

# 屏蔽 VS Code 工作区设置
.vscode/

# 屏蔽临时文件
*.tmp
*.swp

# 屏蔽 OS 相关
Thumbs.db

# 屏蔽其他常见
coverage/
**/coverage/

# 屏蔽本地 node runtime cache
.npm

# 允许忽略外设或工具文件（示例）
# !/scripts/keep.sh (若需要保留某些工具，可使用否定规则)
node_modules/
**/node_modules/
**/node_modules
