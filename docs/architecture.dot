digraph CampusCopilot {
  rankdir=LR;
  node [shape=box, style=rounded];

  subgraph cluster_frontend {
    label = "Frontend (Next.js)";
    AppService [label="App Service\ncampus-copilot-demo\nHTTPS"];
    NextBuild [label="Next.js 16\nStandalone build"];
  }

  subgraph cluster_backend {
    label = "Backend (Azure Functions)";
    FunctionsHost [label="Azure Functions (Flex)\nschool-bot-gwb...\nKoreacentral"];
    Func_schoolBot [label="HTTP Trigger: schoolBot\n/api/schoolbot\nauth: anonymous"];
    Func_ocrCourse [label="HTTP Trigger: ocrCourse\n/api/ocrcourse\nauth: function"];
  }

  subgraph cluster_ci {
    label = "Local CI / Deploy";
    LocalDev [label="Local dev machine\n(func, az, npm)"];
    DeployScripts [label="./deploy-functions.sh\n./deploy-frontend.sh\nremote build (Oryx)"];
  }

  subgraph cluster_external {
    label = "External Services / APIs";
    Cosmos [label="Azure Cosmos DB (optional)\nUser/context store / RAG"];
    Blob [label="Azure Blob / Storage\nStatic assets or uploads"];
    ExternalAPIs [label="3rd-party APIs\nWeather, OCR, Search"];
  }

  AppService -> FunctionsHost [label="API calls /api/*" color=blue];
  AppService -> ExternalAPIs [label="Calls (search, weather)" style=dashed];

  FunctionsHost -> Cosmos [label="Read/Write user context" style=dotted];
  FunctionsHost -> Blob [label="Upload/Download" style=dotted];
  FunctionsHost -> ExternalAPIs [label="OCR / Search / Vision" style=dashed];

  LocalDev -> DeployScripts -> AppService [label="zipdeploy / Kudu"];
  DeployScripts -> FunctionsHost [label="func publish / zipdeploy (remote build)" color=green];

  // Notes
  note [shape=note, label="Key points:\n- Frontend: Next.js standalone on App Service\n- Backend: Azure Functions (Flex); triggers: schoolBot, ocrCourse\n- Deploy: local scripts using Azure CLI + Func tools (remote build)\n- .funcignore excludes node_modules -> use remote build to install deps"];
  note -> DeployScripts [style=dotted];
}
