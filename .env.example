ARIS_HTTP_PORT=3000
ARIS_HTTP_HOST=0.0.0.0

ARIS_AUTH_DISABLED=false
ARIS_AUTH_KEY=change_me_key
ARIS_AUTH_SIGNATURE_SECRET=change_me_signature_secret
ARIS_AUTH_MAX_SKEW_SEC=300

DATABASE_URL=postgres://schoolbot:schoolbot@localhost:5432/schoolbot
POSTGRES_USER=schoolbot
POSTGRES_PASSWORD=schoolbot
POSTGRES_DB=schoolbot

ARIS_WORKER_ENABLED=true
ARIS_WORKER_POLL_MS=30000
ARIS_REMINDER_CRON=0 7 * * *

ARIS_RUNTIME_PROFILE=host
ARIS_CU_ENABLED=true
ARIS_CU_TRANSPORT=mcp_stdio
ARIS_CU_AGENT_TOKEN=
ARIS_CU_MCP_SERVER_CMD=python3 main.py
ARIS_CU_MCP_SERVER_CWD=local/mcp-computer-use-server
ARIS_CU_MCP_TIMEOUT_MS=30000

OPENAI_API_KEY=
ARIS_CU_PLANNER_MODEL=gpt-4o-mini

NAPCAT_API_URL=http://127.0.0.1:6009
NAPCAT_TOKEN=
BOT_QQ_ID=
