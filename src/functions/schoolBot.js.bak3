    "不知火花耶": "1girl, shiranui_kaya, blue_archive, long hair, pink hair, halo, white suit, cape",

    // === 【阿拜多斯 (对策委员会)】 ===
    "白子": "1girl, sunaookami_shiroko, blue_archive, wolf ears, grey hair, mismatched eyes, halo, blue scarf, cross hair ornament, school uniform, cycling shorts",
