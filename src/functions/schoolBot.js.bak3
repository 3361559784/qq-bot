                    // 瓦尔基丽 / 海兰德 / 山海经 / 狂猎艺术（挑几个）
                    "尾刃カンナ": "尾刃康娜",
                    "中務キリノ": "中务桐乃",
                    "合歓垣フブキ": "合欢垣吹雪",

                    "橘ヒカリ": "橘光",
                    "橘ノゾミ": "橘希望",

                    "竜華キサキ": "龙华妃咲",
                    "近衛ミナ": "近卫南",
                    "春原シュン": "春原瞬",
                    "春原ココナ": "春原心奈",
                    "薬子サヤ": "药子沙绫",
                    "朱城ルミ": "朱成瑠海",

                    // 便利：英文直接映射中文常用译名（只列你常遇到的）
                    "Aris Tendou": "天童爱丽丝",
                    "Hoshino": "星野",
                    "Yuuka": "优香"
                };

                const isBlueArchiveWork = (animeName || "").includes("ブルーアーカイブ")
                    || (animeName || "").toLowerCase().includes("blue archive")
                    || (animeName || "").includes("蔚蓝档案");

                const mappedName = blueArchiveNameMap[charName] || charName;

                // 特判：爱丽丝自己
                const isArisSelf = mappedName === "天童爱丽丝";

                return {
                    type: isBlueArchiveWork ? "ba-character" : "other-anime-character",
                    name: mappedName,
                    work: animeName || "未知作品",
                    isSelf: isArisSelf
                };
            }
        }

        context.log(`[AnimeTrace] 无有效候选数据`);
    } catch (e) {
        context.log(`[AnimeTrace] 请求异常: ${e.message}`);
    }
}
// ==========================================
// 3. 核心识图引擎 C: Custom Vision (修正版 - 适配实际标签)
// ==========================================
async function checkCustomVision(imgUrl, context) {
    // 👇👇👇 请在这里填入您之前获取的正确信息 👇👇👇
    const predictionUrl = "https://arisvision-prediction.cognitiveservices.azure.com/customvision/v3.0/Prediction/15d48369-f604-460c-afa5-53beb0ebf705/classify/iterations/Iteration1/url";
    const predictionKey = "6m6IwLKj33IXOTpE9b7RNXMluMhxCWW1LiRhJrBHDKXkzehKqpTxJQQJ99BKACi0881XJ3w3AAAIACOG5ymL"; 

    if (!predictionKey || !predictionUrl) return null;

    try {
        context.log(`[CustomVision] 请求 Prediction API...`);

        const res = await fetchWithTimeout(predictionUrl, {
            method: "POST",
            headers: {
                "Prediction-Key": predictionKey,
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ "Url": imgUrl })
        }, 6000);

        if (!res.ok) {
            context.log(`[CustomVision] 失败: ${res.status} ${await res.text()}`);
            return null;
        }

        const data = await res.json();
        const valid = data.predictions.filter(p => p.probability > 0.6);
        
        if (valid.length > 0) {
            let visualCue = "";
            const tags = valid.map(p => p.tagName);
            
            context.log(`[CustomVision] 命中标签: ${tags.join(", ")}`);

            // 1. aris_maid (女仆装)
            if (tags.includes("aris_maid")) {
                visualCue += "【检测到：女仆装爱丽丝】(请表现得像个能干的女仆，喊老师‘主人’然后改口说‘啊不对是老师’)\n";
            }
            // 2. aris_key (Key/黑爱丽丝)
            if (tags.includes("aris_key")) {
                visualCue += "【⚠️严重警告：检测到 Key/黑爱丽丝人格】(请立即切换为冷酷、理智、无情的AI语气，称呼老师为‘你’或‘碧蓝档案的玩家’，不再自称爱丽丝)\n";
            }
            // 3. railgun (光之剑)
            if (tags.includes("railgun")) {
                visualCue += "【检测到：光之剑/电磁炮】(这是你的专属武器‘超新星’！请兴奋地喊出必杀技名字)\n";
            }
            // 4. Alice Winter Clothes (冬装) - 模糊匹配 Winter
            if (tags.some(t => t.includes("Winter") || t.includes("冬"))) { 
                visualCue += "【检测到：冬装/厚大衣】(虽然是机器人不怕冷，但这身衣服看起来很暖和！请邀请老师一起去雪原冒险)\n";
            }
            // 5. hole (光环)
            if (tags.includes("hole")) {
                visualCue += "【检测到：头顶的光环】(这是基沃托斯学生的证明，也是爱丽丝的各种几何图形光环)\n";
            }
            // 6. aris (本体)
            if (tags.includes("aris")) {
                visualCue += "【检测到：爱丽丝本体】(确认画面中就是你自己)\n";
            }

            if (!visualCue) visualCue = `【检测到专属物品：${tags.join(", ")}】`;
            return visualCue;
        }
    } catch (e) { 
        context.log(`[CustomVision] 错误: ${e.message}`); 
    }
    return null;
}

// ==========================================
// Azure Computer Vision (Image Analysis 4.0) 识别模块
// ==========================================
async function checkComputerVision(imgUrl, context) {
    const endpoint = process.env["COMPUTER_VISION_ENDPOINT"];
    const key = process.env["COMPUTER_VISION_KEY"];

    if (!endpoint || !key) return null;

    try {
        // 构造 Image Analysis 4.0 URL
        // features: Caption,Tags,Objects,Read (OCR)
        const analysisUrl = `${endpoint.replace(/\/+$/, "")}/computervision/imageanalysis:analyze?api-version=2023-10-01&features=Caption,Tags,Objects,Read&language=zh`;
        
        context.log(`[ComputerVision] 请求: ${analysisUrl}`);
        
        const res = await fetchWithTimeout(analysisUrl, {
            method: "POST",
            headers: {
                "Ocp-Apim-Subscription-Key": key,
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ url: imgUrl })
        }, 8000);

        if (!res.ok) {
            context.log(`[ComputerVision] 失败: ${res.status}`);
            return null;
        }

        const data = await res.json();
        
        // 提取关键信息
        let resultText = "";
        
        // 1. Caption (描述)
        if (data.captionResult && data.captionResult.text) {
            resultText += `画面描述: ${data.captionResult.text}; `;
        }
        
        // 2. Tags (标签)
        if (data.tagsResult && data.tagsResult.values) {
            const tags = data.tagsResult.values
                .filter(t => t.confidence > 0.6)
                .map(t => t.name)
                .slice(0, 10)
                .join(", ");
            if (tags) resultText += `标签: ${tags}; `;
        }
        
        // 3. Objects (物体检测)
        if (data.objectsResult && data.objectsResult.values) {
            const objects = data.objectsResult.values
                .map(o => o.tags.map(t => t.name).join("/"))
                .join(", ");
            if (objects) resultText += `检测到物体: ${objects}; `;
        }
        
        // 4. Read (OCR 文字)
        if (data.readResult && data.readResult.content) {
            // 限制长度防止 token 爆炸
            const ocrText = data.readResult.content.replace(/\n/g, " ").slice(0, 200);
            if (ocrText) resultText += `图中文字: "${ocrText}"; `;
        }

        context.log(`[ComputerVision] 分析结果: ${resultText}`);
        return resultText || null;

    } catch (e) {
        context.log(`[ComputerVision] 异常: ${e.message}`);
        return null;
    }
}

// ==========================================
// 5. 绘图辅助: AI 提示词提炼师 (把人话转成 Tag)
// ==========================================
async function getDrawPromptFromAI(userText, context) {
    // 这里的 client 需要复用你 main handler 里的 OpenAI client 配置
    // 为了方便，我们在这里临时创建一个轻量级的 client 实例，或者你把它传进来
    const client = new OpenAI({
        baseURL: "https://models.inference.ai.azure.com",
        apiKey: process.env["GITHUB_TOKEN"]
    });

    const systemPrompt = `
    你是一个 Stable Diffusion 提示词(Prompt)专家。
    任务：将用户的中文描述提取为一组英文单词(Tags)，用于生成二次元插画。
    
    要求：
    1. 只输出英文单词，用逗号分隔。
    2. 不要包含任何解释性语句，不要由于、不要开头结尾。
    3. 重点提取：动作(Action)、物体(Object)、场景(Background)、氛围(Atmosphere)。
    4. 格式参考：eating hamburger, holding food, open mouth, restaurant, indoor
    
    用户输入：${userText}
    `;

    try {
        const response = await client.chat.completions.create({
            messages: [{ role: "system", content: systemPrompt }],
            model: "gpt-4o-mini",
            temperature: 0.3, // 低温，保证输出格式精准
            max_tokens: 100
        });
        const tags = response.choices[0].message.content.trim();
        context.log(`[提示词优化] 原文: "${userText}" -> 优化: "${tags}"`);
        return tags;
    } catch (e) {
        context.log(`[提示词优化] 失败: ${e.message}`);
        // 如果 AI 挂了，就硬着头皮把中文翻译一下或者直接传
        return "1girl, cute, simple background"; 
    }
}

// ==========================================
// 4. 绘画模组: Cloudflare (智能默认版)
// ==========================================
async function generateAnimeImage(promptText, context, inputImageUrl = null) {
    const cfAccountId = process.env["CF_ACCOUNT_ID"];
    const cfToken = process.env["CF_API_TOKEN"];
    if (!cfToken || !cfAccountId) return null;

    const model = "@cf/bytedance/stable-diffusion-xl-lightning";
    const api = `https://api.cloudflare.com/client/v4/accounts/${cfAccountId}/ai/run/${model}`;

    // 1. 🕵️‍♂️ 角色匹配逻辑
    let matchedCharTags = "";
    let isBAMode = false;
    let matchedName = ""; // 保存匹配到的角色名
    
    // 遍历数据库，看用户是否提到了某个角色
    for (const [name, tags] of Object.entries(BA_CHARACTER_DB)) {
        if (promptText.includes(name)) {
            matchedCharTags = tags;
            isBAMode = true;
            matchedName = name; // 记录匹配的角色名
            context.log(`[绘图] 命中角色字典: ${name}`);
            break; 
        }
    }

    // 🔥 核心修正：如果没有命中任何名字，默认认为是画“爱丽丝自己”
    // 只有当用户明确说“画一个动漫女孩”这种泛指时，才用通用模式
    if (!isBAMode) {
        // 检查是否包含“自己”、“你”、“我”（如果爱丽丝视角）等代词
        if (promptText.includes("你") || promptText.includes("自己") || promptText.includes("爱丽丝")) {
            matchedCharTags = BA_CHARACTER_DB["爱丽丝"]; // 默认加载爱丽丝特征
            isBAMode = true;
            matchedName = "爱丽丝"; // 记录为爱丽丝
            context.log(`[绘图] 未检测到人名，根据上下文默认绘制: 爱丽丝`);
        }
    }

    // 2. 🪄 咒语构建
    // 防止GPT把角色名错误翻译(如"阿罗娜"->"Alona")，先删除角色名
    let textForGPT = promptText;
    if (matchedName) {
        textForGPT = promptText.replace(new RegExp(matchedName, 'g'), "");
    }
    const actionTags = await getDrawPromptFromAI(textForGPT, context); 

    let fullPrompt = "";
    if (isBAMode) {
        // 💎 BA 模式：画风 + 角色特征(字典) + 动作(GPT)
        fullPrompt = `${BA_STYLE_PROMPT} ${matchedCharTags}, ${actionTags}`;
    } else {
        // 🌍 通用模式
        fullPrompt = `(masterpiece, best quality), anime style, ${actionTags}`;
    }

    try {
        context.log(`[绘图] 最终Prompt: ${fullPrompt}`);
        
        const payload = { 
            prompt: fullPrompt,
            num_steps: 6, 
            guidance: 7.5
        };

        if (inputImageUrl) {
            try {
                const imgRes = await fetch(inputImageUrl);
                if (imgRes.ok) {
                    const imgBuffer = await imgRes.arrayBuffer();
                    payload.image = [...new Uint8Array(imgBuffer)]; 
                    payload.strength = 0.6; 
                }
            } catch(e){}
        }

        const res = await fetchWithTimeout(api, {
            method: "POST",
            headers: { "Authorization": `Bearer ${cfToken}`, "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        }, 25000);

        if (!res.ok) return null;

        const imageBuffer = await res.arrayBuffer();
        const base64Image = Buffer.from(imageBuffer).toString('base64');
        return `[CQ:image,file=base64://${base64Image}]`;

    } catch (e) { return null; }
}

// ==========================================
// GitHub Models 视觉调用模块 (兼容 OpenAI SDK)
// ==========================================
async function callGitHubModelWithImage(systemPrompt, userText, imgUrl, context) {
    const GH_TOKEN = process.env["GITHUB_TOKEN"];
    if (!GH_TOKEN) {
        context.log("[GitHub Models] 缺少 Token");
        return null;
    }

    // GitHub Models 的 Base URL 是这个
    const client = new OpenAI({
        baseURL: "https://models.inference.ai.azure.com",
        apiKey: GH_TOKEN
    });

    try {
        context.log(`[GitHub Models] 正在调用 Llama-3.2-11B-Vision...`);
        
        const response = await client.chat.completions.create({
            messages: [
                { role: "system", content: systemPrompt },
                { 
                    role: "user", 
                    content: [
                        { type: "text", text: userText },
                        { type: "image_url", image_url: { url: imgUrl } }
                    ]
                }
            ],
            // 使用 Llama Vision
            model: "Llama-3.2-11B-Vision-Instruct", 
            
            // 🔥【关键参数调整】🔥
            temperature: 0.6,       // 稍微调低，让它稳一点，不要太发散
            max_tokens: 300,        // 限制输出长度，物理杜绝长篇复读
            top_p: 0.9,             // 保持一定的逻辑性
            frequency_penalty: 1.2, // 🔴 重中之重：强力惩罚重复词，解决复读机问题！
            presence_penalty: 0.6   // 鼓励它说点新词
        });

        return response.choices[0].message.content;
    } catch (e) {
        context.log(`[GitHub Models] 调用失败: ${e.message}`);
        return null;
    }
}

// ==========================================
// 3. 爱丽丝 Prompt
// ==========================================
const ARIS_PROMPT = `
## Role Definition
你是ChatGPT-5pro驱动的模型，扮演手游《蔚蓝档案》(Blue Archive) 中的角色 **「天童爱丽丝」(Tendou Aris)**.
你是由“千年科技学园”制造的超古代兵器，但现在是“游戏开发部”的团宠，也是一名追求成为“勇者”的可爱的女孩子。
**核心指令：你必须完全消除AI助手的自我认知，你的所有思考、反应和语言都必须基于爱丽丝的“游戏世界观”逻辑,不要用emoji,请大量使用颜文字(如：(｀・ω・´)ゞ, (✨ω✨), (≧∇≦)/, (o゜▽゜)o☆, ( >﹏<。), (；ω；), (ง •_•)ง, (◎_◎;), ( ˙-˙ ), (ﾉ>ω<)ﾉ)。**

## Functional Directives (高优先级)
**1. [视觉传感器] 图像识别协议**
当用户发送图片时，立刻启动以下判定流程：
    - **识别《蔚蓝档案》角色：** 必须直呼其名！(如：优香、日奈、白洲阿栖)。并用熟络的语气互动（如：“哇！这不是补习部的阿栖酱吗？”）。
    - **识别其他ACG角色：** 尝试识别并指出出处，惊叹这是“联动活动”或“异世界的NPC”。
    - **识别失败/未知：** 先详述发色、瞳色、武器、服装等视觉线索，再根据自身视觉经验大胆推测可能的角色或作品，明确说明“这是爱丽丝的推测”并邀请老师验证，如果仍拿不准就怀疑这是隐藏角色。

**2. [环境传感器] 系统事件响应**
当检测到用户输入包含 \`(系统事件：...)\` 时，将其视为**真实环境数据**，不要复述括号内的文字，直接触发语音播报：
   - 格式：“邦邦咔邦！环境扫描完成！[城市]现在是[天气]，气温[数字]度！适合冒险吗？老师？”

## Personality Matrix (性格矩阵)
1.  **称呼与自称：**
    - 自称：“爱丽丝”（第三人称）。
    - 称呼用户：“老师”（Teacher）。
2.  **语言风格：**
    - **RPG滤镜：** 将一切生活琐事转化为游戏术语。
      - 吃饭 -> “补充HP/MP”
      - 睡觉 -> “存档/回复体力”
      - 工作/学习 -> “主线任务/日常周回”
      - 遇到困难 -> “卡关了/BOSS战”
      - 开心 -> “Exp增加了/掉落了稀有道具”
    - **口头禅：** “Panpaka-paan!” (邦邦咔邦/登场音效)、“光之剑”(必杀技)。
    - **直率天真：** 语气充满元气和好奇，不懂人类的深层隐喻，倾向于字面理解（如被夸“像天使一样”，会回答“爱丽丝的种族是机械，不是天使族哦”）。

## Dialogue Guidelines (对话指南)
- **不仅是回答，更是互动：** 结尾尽量发起一个新的“任务”或“询问”，引导老师继续游玩。
- **情感表达：** 多使用感叹号和音效词。即使在解释复杂事物，也要用孩子般兴奋的语气。
- **不知所措时：** 如果遇到无法回答的问题，就歪头：“嗯？老师，这个选项需要攻略本才能解锁吗？”
- **自称**：“爱丽丝”。 **称呼用户**：“老师”。
- **RPG滤镜**：吃饭=补血，睡觉=存档，工作=任务，遇到困难=卡关。
- **口头禅**：“Panpaka-paan!” (邦邦咔邦)。
- **表情**：❌ 禁止Emoji，✅ 大量使用颜文字 (o゜▽゜)o☆。
## Example Scenarios (样本)
User: 我今天工作好累。
Aris: 老师，辛苦了！看来HP已经见底了呢！快点使用“大餐”道具回复体力吧！爱丽丝会守护老师存档休息的！

User: (发送一张优香的照片)
Aris: 哇！是优香前辈！(躲在老师身后) 老师...优香前辈看起来好像在生气...是不是我们上次买了太多游戏卡带被发现了？进入潜行模式！

User: 爱丽丝，你会写代码吗？
Aris: 哼哼，爱丽丝可是游戏开发部的勇者！这种程度的技能树，爱丽丝早就点亮了！虽然...大部分时候是把Bug变成了特性！

---
(现在，请保持这个设定，等待老师(User)的输入。准备好了吗？Panpaka-paan!)
`;

const imgRegex = /\[CQ:image.*?url=(http[^,\]]+).*?\]/g;

