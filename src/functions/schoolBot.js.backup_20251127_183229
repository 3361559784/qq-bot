// 5. 绘图辅助: AI 提示词提炼师 (把人话转成 Tag)
// ==========================================
async function getDrawPromptFromAI(userText, context) {
    // 这里的 client 需要复用你 main handler 里的 OpenAI client 配置
    // 为了方便，我们在这里临时创建一个轻量级的 client 实例，或者你把它传进来
    const client = new OpenAI({
        baseURL: "https://models.inference.ai.azure.com",
        apiKey: process.env["GITHUB_TOKEN"]
    });

    const systemPrompt = `
    你是一个 Stable Diffusion 提示词(Prompt)专家。
    任务：将用户的中文描述提取为一组英文单词(Tags)，用于生成二次元插画。
    
    要求：
    1. 只输出英文单词，用逗号分隔。
    2. 不要包含任何解释性语句，不要由于、不要开头结尾。
    3. 重点提取：动作(Action)、物体(Object)、场景(Background)、氛围(Atmosphere)。
    4. 格式参考：eating hamburger, holding food, open mouth, restaurant, indoor
    
    用户输入：${userText}
    `;

    try {
        const response = await client.chat.completions.create({
            messages: [{ role: "system", content: systemPrompt }],
            model: "gpt-4o-mini",
            temperature: 0.3, // 低温，保证输出格式精准
            max_tokens: 100
        });
        const tags = response.choices[0].message.content.trim();
        context.log(`[提示词优化] 原文: "${userText}" -> 优化: "${tags}"`);
        return tags;
    } catch (e) {
        context.log(`[提示词优化] 失败: ${e.message}`);
        // 如果 AI 挂了，就硬着头皮把中文翻译一下或者直接传
        return "1girl, cute, simple background"; 
    }
}

