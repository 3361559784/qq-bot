// 4. 绘画模组: Cloudflare (DreamShaper 8 + Reference-Guided 底图作弊)
// ==========================================
async function generateAnimeImage(rawUserText, context, inputImageUrl = null) {
    const cfAccountId = process.env["CF_ACCOUNT_ID"];
    const cfToken = process.env["CF_API_TOKEN"];
    
    if (!cfToken || !cfAccountId) {
        context.log("[绘图] ❌ 缺少 Cloudflare 配置，无法启用 Reference-Guided 模式");
        return null;
    }

    // 1. 查字典 (获取角色特征 Tag)
    let charTags = "";
    let isBAMode = false;
    let matchedName = "";
    
    for (const [name, tags] of Object.entries(BA_CHARACTER_DB)) {
        if (rawUserText.includes(name)) {
            charTags = tags; 
            isBAMode = true;
            matchedName = name;
            context.log(`[绘图] 命中角色: ${name}`);
            break; 
        }
    }

    // 默认兜底
    if (!isBAMode && (rawUserText.includes("你") || rawUserText.includes("自己") || rawUserText.includes("爱丽丝"))) {
        charTags = BA_CHARACTER_DB["爱丽丝"];
        isBAMode = true;
        matchedName = "爱丽丝";
    }

    // 2. 🔥 核心逻辑：底图注入 (Reference-Guided)
    let useReference = false;
    
    // 情况 A: 用户自己发了图 (修图模式) -> 用用户的图
    // 情况 B: 用户没发图，但我们要画特定角色 (作弊模式) -> 自动注入立绘！
    if (!inputImageUrl && matchedName && CHAR_REF_IMAGES[matchedName]) {
        inputImageUrl = CHAR_REF_IMAGES[matchedName];
        useReference = true;
        context.log(`[绘图] 🎯 启用作弊模式：加载【${matchedName}】的标准底图`);
    } else if (inputImageUrl) {
        context.log(`[绘图] 📸 用户提供了参考图，启用修图模式`);
    }

    // 3. 提炼动作 (GPT 生成动作标签)
    let textForGPT = matchedName ? rawUserText.replace(new RegExp(matchedName, 'g'), "") : rawUserText;
    const actionTags = await getDrawPromptFromAI(textForGPT, context);

    // 4. 组合 Prompt (DreamShaper 专用格式)
    let fullPrompt = "";
    if (isBAMode) {
        // BA 模式: 角色特征 + 动作 + 质量词
        fullPrompt = `(masterpiece, best quality, highres), anime style, ${charTags}, ${actionTags}, soft lighting, detailed background`;
    } else {
        // 通用模式
        fullPrompt = `(masterpiece, best quality), anime style, 1girl, ${actionTags}, soft lighting`;
    }

    try {
        context.log(`[绘图] 请求 Cloudflare DreamShaper: ${fullPrompt}`);
        
        // 使用 DreamShaper 8 LCM (画风极好的动漫模型)
        const api = `https://api.cloudflare.com/client/v4/accounts/${cfAccountId}/ai/run/@cf/lykon/dreamshaper-8-lcm`;
        
        const payload = { 
            prompt: fullPrompt,
            num_steps: 8,      // LCM 快速推理
            guidance: 2.0      // LCM 低引导值更自然
        };

        // 5. 处理底图数据 (Reference-Guided 核心)
        if (inputImageUrl) {
            context.log(`[绘图] 下载参考图: ${inputImageUrl}`);
            const imgRes = await fetch(inputImageUrl);
            
            if (imgRes.ok) {
                const imgBuffer = await imgRes.arrayBuffer();
                // Cloudflare 需要整数数组格式
                payload.image = [...new Uint8Array(imgBuffer)]; 
                
                // ⭐ Strength (重绘幅度) 调教：
                // 0.1 = 基本不变 (保留原图99%)
                // 1.0 = 完全重画 (只参考一点点)
                // 
                // 作弊模式 (0.75): 既要保留立绘的特征(发型/光环/衣服)，又要让它动起来(做动作)
                // 修图模式 (0.6): 稍微改改用户的图
                payload.strength = useReference ? 0.75 : 0.6;
                
                context.log(`[绘图] 底图加载成功，重绘强度: ${payload.strength} (${useReference ? '作弊模式' : '修图模式'})`);
            } else {
                context.log(`[绘图] ⚠️ 底图下载失败 (${imgRes.status})，改用 Text2Img`);
            }
        }

        const res = await fetchWithTimeout(api, {
            method: "POST",
            headers: { 
                "Authorization": `Bearer ${cfToken}`, 
                "Content-Type": "application/json" 
            },
            body: JSON.stringify(payload)
        }, 25000); // 25秒超时

        if (!res.ok) {
            const errText = await res.text();
            context.log(`[绘图] Cloudflare 失败 (${res.status}): ${errText}`);
            return null;
        }

        const imageBuffer = await res.arrayBuffer();
        const base64Image = Buffer.from(imageBuffer).toString('base64');
        context.log(`[绘图] ✅ 成功生成图片 (${useReference ? '作弊模式' : inputImageUrl ? '修图模式' : '文生图模式'})`);
        return `[CQ:image,file=base64://${base64Image}]`;

    } catch (e) {
        context.log(`[绘图] 异常: ${e.message}`);
        return null;
    }
}

